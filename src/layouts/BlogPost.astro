---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import ToC from '../components/ToC.astro';
import VersionBox from '../components/VersionBox.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import CopyPage from '../components/CopyPage.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TreeNav from '../components/TreeNav.astro';
import { SITE } from '../lib/site.mjs';

const base = import.meta.env.BASE_URL;
const { post, version, prev, next, related, page, treePrev, treeNext } = Astro.props;
const meta = page ?? version;
const entry = meta.entry;
const data = entry.data;
const { Content, headings } = await render(entry);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
let ogImage = new URL(`${base}og-default.svg`, Astro.site).href;
const fallbackMeta = data.thumbnail ?? meta.thumbnailMeta;
if (fallbackMeta) {
  const img = await getImage({ src: fallbackMeta });
  ogImage = new URL(img.src, Astro.site).href;
} else if (meta.thumbnailUrl) {
  ogImage = new URL(meta.thumbnailUrl, Astro.site).href;
}

const breadcrumbSteps = [
  { name: 'Home', item: new URL(base + '/', Astro.site).href },
  { name: 'Blog', item: new URL(base + 'blogs/', Astro.site).href },
  ...(page
    ? [{ name: post.latest.title, item: new URL(`${base}blogs/${post.slug}/`, Astro.site).href }]
    : []),
  ...(page?.crumbs ?? []).map((c) => ({
    name: c.title,
    item: new URL(`${base}blogs/${post.slug}/${c.urlPath ? `${c.urlPath}/` : ''}`, Astro.site).href,
  })),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: meta.title,
    description: data.description ?? post.data.description ?? meta.excerpt,
    url: canonical,
    image: ogImage,
    datePublished: meta.date.toISOString(),
    dateModified: meta.date.toISOString(),
    inLanguage: data.lang,
    author: { '@type': 'Person', name: SITE.author },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      ...breadcrumbSteps.map((s, i) => ({ '@type': 'ListItem', position: i + 1, ...s })),
      { '@type': 'ListItem', position: breadcrumbSteps.length + 1, name: meta.title, item: canonical },
    ],
  },
];

const dateStr = meta.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const versionNums = post.versions.map((v) => v.version);
const latestVersion = versionNums[versionNums.length - 1];
const lede = page ? post.data.description ?? null : data.description;
const headerCategory = page ? post.data.category : data.category;
const headerTags = page ? (post.data.tags ?? []) : data.tags;
---

<BaseLayout
  title={`${meta.title} — ${SITE.name}`}
  description={data.description ?? post.data.description ?? meta.excerpt}
  lang={data.lang}
  ogImage={ogImage}
  canonical={canonical}
  publishedTime={meta.date}
  jsonLd={jsonLd}
>
  {!page && (
  <script is:inline data-astro-rerun define:vars={{ base, slug: post.slug, versionNums, latestVersion }}>
    (() => {
      const q = new URLSearchParams(location.search).get('version');
      if (!q) return;
      const wanted = q === 'latest' ? latestVersion : Number(q);
      const path = location.pathname;
      const bare = base + 'blogs/' + slug + '/';
      if (!Number.isInteger(wanted) || !versionNums.includes(wanted)) {
        if (path !== bare) location.replace(bare);
        else history.replaceState(null, '', bare);
        return;
      }
      const target = wanted === latestVersion ? bare : bare + 'v' + wanted + '/';
      if (path !== target) location.replace(target);
      else history.replaceState(null, '', target);
    })();
  </script>
  )}

  <ReadingProgress />

  <div class="post-shell">
  <article class="post-column" dir={data.lang === 'ar' ? 'rtl' : undefined} data-pagefind-body>
  <div class="post-topbar">
    <a class="post-back" href={`${base}blogs/`}>← Blog</a>
    <CopyPage mdUrl={page ? `${base}blogs/${page.id}.md` : version.version === latestVersion ? `${base}blogs/${post.slug}.md` : `${base}blogs/${post.slug}/v${version.version}.md`} />
  </div>
  <header class="post-header">
      <div class="post-header__meta">
        <span class="meta-label">{dateStr}</span>
        {headerCategory && <span class="card__category">{headerCategory}</span>}
        <span class="visually-hidden" data-pagefind-filter={`category:${headerCategory ?? 'uncategorized'}`}></span>
        <span class="visually-hidden" data-pagefind-meta={`date:${dateStr}`}></span>
      </div>
      <h1 class="post-title post-header__title" lang={data.lang} data-pagefind-meta="title">{meta.title}</h1>
      {lede && <p class="post-lede post-header__lede" lang={data.lang}>{lede}</p>}
      {headerTags.length > 0 && (
        <div class="post-tags">
          {headerTags.map((t) => (
            <span class="post-tag">{t}</span>
          ))}
        </div>
      )}
    </header>

    {post.isTree && <TreeNav post={post} current={page ? page.urlPath : ''} />}

    <div class="toc-inline">
      <ToC headings={headings} />
    </div>

    <div class="post-body" lang={data.lang}>
      <Content />
    </div>

    <nav class="post-nav" aria-label="More posts">
      {page && treePrev && (
        <a class="post-nav__link" href={`${base}blogs/${post.slug}/${treePrev.urlPath ? `${treePrev.urlPath}/` : ''}`}>
          <span class="post-nav__label">← Previous</span>
          <span>{treePrev.title}</span>
        </a>
      )}
      {page && !treePrev && (
        <a class="post-nav__link" href={`${base}blogs/${post.slug}/`}>
          <span class="post-nav__label">← Overview</span>
          <span>{post.latest.title}</span>
        </a>
      )}
      {!page && prev && (
        <a class="post-nav__link" href={`${base}blogs/${prev.slug}/`}>
          <span class="post-nav__label">← Previous</span>
          <span>{prev.title}</span>
        </a>
      )}
      {page && treeNext && (
        <a class="post-nav__link post-nav__link--next" href={`${base}blogs/${post.slug}/${treeNext.urlPath}/`}>
          <span class="post-nav__label">Next →</span>
          <span>{treeNext.title}</span>
        </a>
      )}
      {!page && next && (
        <a class="post-nav__link post-nav__link--next" href={`${base}blogs/${next.slug}/`}>
          <span class="post-nav__label">Next →</span>
          <span>{next.title}</span>
        </a>
      )}
    </nav>
  </article>

  {post.versions.length > 1 && <VersionBox slug={post.slug} versions={post.versions} current={version.version} />}

  {headings.some((h) => h.depth >= 2) && (
    <aside class="toc-rail" dir={data.lang === 'ar' ? 'rtl' : undefined}>
      <button class="toc-rail__toggle" type="button" data-toc-toggle aria-expanded="false" aria-controls="toc-panel">
        <svg class="toc-rail__chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        <span>Contents</span>
      </button>
      <nav class="toc-rail__panel" id="toc-panel" aria-label="Table of contents">
        <ToC headings={headings} />
      </nav>
    </aside>
  )}
  </div>

  <script>
    import '../scripts/toc-rail.js';
  </script>

  {related && related.length > 0 && <RelatedPosts related={related} />}

  <script>
    import '../scripts/toc-rail.js';
  </script>
</BaseLayout>
