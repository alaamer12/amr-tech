---
import BlogPost from '../../layouts/BlogPost.astro';
import AliasRedirect from '../../components/AliasRedirect.astro';
import CanonicalRedirect from '../../components/CanonicalRedirect.astro';
import { getPosts, relatedOf } from '../../lib/posts.mjs';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const base = import.meta.env.BASE_URL;
  const posts = await getPosts();
  const paths = [];
  posts.forEach((post, i) => {
    const prev = i < posts.length - 1 ? { slug: posts[i + 1].slug, title: posts[i + 1].latest.title } : null;
    const next = i > 0 ? { slug: posts[i - 1].slug, title: posts[i - 1].latest.title } : null;
    const related = relatedOf(post, posts);

    if (post.isTree) {
      paths.push({
        params: { slug: post.slug },
        props: { post, version: post.latest, prev, next, related, alias: false, indexRedirect: false },
      });
      post.tree.forEach((page, j) => {
        if (page.urlPath === '') {
          // <slug>.md already maps to the folder URL; offer the /index/ alias too
          paths.push({
            params: { slug: `${post.slug}/index` },
            props: { redirect: `${base}blogs/${post.slug}/`, alias: false, indexRedirect: true },
          });
          return;
        }
        const treePrev = j > 0 ? post.tree[j - 1] : null;
        const treeNext = j < post.tree.length - 1 ? post.tree[j + 1] : null;
        paths.push({
          params: { slug: `${post.slug}/${page.urlPath}` },
          props: {
            post,
            version: post.latest,
            page,
            treePrev,
            treeNext,
            related,
            alias: false,
            indexRedirect: false,
          },
        });
        if (/\/(index|readme)$/i.test(page.id)) {
          paths.push({
            params: { slug: `${post.slug}/${page.id.slice(post.slug.length + 1)}` },
            props: { redirect: `${base}blogs/${post.slug}/${page.urlPath}/`, alias: false, indexRedirect: true },
          });
        }
      });
      return;
    }

    const latestVersion = post.versions[post.versions.length - 1];
    for (const version of post.versions) {
      const isLatest = version.version === latestVersion.version;
      paths.push({
        params: { slug: isLatest ? post.slug : `${post.slug}/v${version.version}` },
        props: { post, version, prev, next, related, alias: false, indexRedirect: false },
      });
    }
    if (post.versions.length > 1) {
      paths.push({
        params: { slug: `${post.slug}/v${latestVersion.version}` },
        props: { post, version: latestVersion, prev: null, next: null, alias: true, indexRedirect: false },
      });
    }
  });
  return paths;
}

const { post, version, prev, next, alias, indexRedirect, redirect, page, treePrev, treeNext } = Astro.props;
---

{indexRedirect ? (
  <CanonicalRedirect target={redirect} site={Astro.site} />
) : alias ? (
  <AliasRedirect slug={post.slug} base={base} site={Astro.site} />
) : (
  <BlogPost
    post={post}
    version={version}
    prev={prev}
    next={next}
    related={Astro.props.related}
    page={page ?? null}
    treePrev={treePrev ?? null}
    treeNext={treeNext ?? null}
  />
)}
